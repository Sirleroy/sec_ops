# App
NODE_ENV=development
PORT=3000

# Database (Docker — port 5433 to avoid conflict with native Postgres)
DATABASE_URL=postgresql://secops:secops_dev@localhost:5433/secops_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=secops-media

# Mapbox
MAPBOX_PUBLIC_TOKEN=
MAPBOX_SECRET_TOKEN=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# NIMC (NIN verification)
NIMC_API_KEY=
NIMC_BASE_URL=
